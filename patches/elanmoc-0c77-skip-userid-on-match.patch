Description: elanmoc: skip get-userid after match on 0c77, report directly
 After a successful on-chip match the stock driver issues a get-userid
 command (to learn which finger matched) and reports the result from
 its callback. The 0c77 FW does not implement that command: the read
 times out after 5s and then crashes with "fpi_ssm_mark_failed:
 assertion 'machine != NULL' failed" because the identify SSM has
 already completed. For ELANMOC_PROTO_V2 the match-on-chip result is
 authoritative, so report FPI_MATCH_SUCCESS (verify) / the gallery
 print (identify) directly, mirroring the existing match-fail path.
Author: local
Last-Update: 2026-06-12
--- a/libfprint/drivers/elanmoc/elanmoc.c
+++ b/libfprint/drivers/elanmoc/elanmoc.c
@@ -767,6 +767,34 @@ identify_status_report (FpiDeviceElanmoc
     case RSP_VERIFY_OK:
       {
         fp_dbg ("Verify was successful! for user: %d mesg_code: %d ", data, verify_status_id);
+
+        /* ELANMOC_PROTO_V2 chips (e.g. 04f3:0c77) do not implement the
+         * get-userid command the stock driver sends after a match to read
+         * back which finger was hit; issuing it just times out and then
+         * crashes (the identify SSM has already advanced). The match-on-chip
+         * has already confirmed the finger, so report the result directly.
+         */
+        if (fpi_device_get_driver_data (device) == ELANMOC_PROTO_V2)
+          {
+            if (fpi_device_get_current_action (device) == FPI_DEVICE_ACTION_VERIFY)
+              {
+                FpPrint *verify_print = NULL;
+                fpi_device_get_verify_data (device, &verify_print);
+                fpi_device_verify_report (device, FPI_MATCH_SUCCESS, verify_print, NULL);
+                fpi_device_verify_complete (device, NULL);
+              }
+            else
+              {
+                GPtrArray *prints = NULL;
+                fpi_device_get_identify_data (device, &prints);
+                fpi_device_identify_report (device,
+                                            (prints && prints->len) ? g_ptr_array_index (prints, 0) : NULL,
+                                            NULL, NULL);
+                fpi_device_identify_complete (device, NULL);
+              }
+            break;
+          }
+
         cmd_buf = elanmoc_compose_cmd (&elanmoc_get_userid_cmd);
         cmd_buf[2] = data;
         elanmoc_get_cmd (device, cmd_buf, elanmoc_get_userid_cmd.cmd_len, elanmoc_get_userid_cmd.resp_len, 0, elanmoc_match_report_cb);
