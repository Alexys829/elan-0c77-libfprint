Index: libfprint-1.95.1+tod1/libfprint/drivers/elanmoc/elanmoc.h
===================================================================
--- libfprint-1.95.1+tod1.orig/libfprint/drivers/elanmoc/elanmoc.h
+++ libfprint-1.95.1+tod1/libfprint/drivers/elanmoc/elanmoc.h
@@ -156,6 +156,21 @@ static const struct elanmoc_cmd elanmoc_
   .resp_len = 2,
 };
 
+/* Replacement for get-userid (43 21 <slot>), which this FW never answers.
+ * Returns the same user_id payload, but the frame carries one extra byte:
+ *   43 21 : [0]=0x43 [1]=status [2..3]=uuid [4]=len   [5..]=user_id
+ *   40 ff 12: [0]=0x40 [1]=status [2..3]=uuid [4]=pad [5]=len [6..]=user_id
+ * An empty slot answers immediately with len == 0.
+ */
+static const struct elanmoc_cmd elanmoc_finger_info_cmd_v2 = {
+  .cmd_header = {0x40, 0xff, 0x12},
+  .cmd_len = 4,
+  .resp_len = 70,
+};
+
+#define ELANMOC_USERID_LEN_OFFSET   4
+#define ELANMOC_USERID_LEN_OFFSET_V2 5
+
 typedef void (*ElanCmdMsgCallback) (FpiDeviceElanmoc *self,
                                     GError           *error);
 
