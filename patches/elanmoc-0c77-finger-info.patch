--- libfprint-1.95.1+tod1.orig/libfprint/drivers/elanmoc/elanmoc.c
+++ libfprint-1.95.1+tod1/libfprint/drivers/elanmoc/elanmoc.c
@@ -69,6 +69,46 @@ elanmoc_compose_cmd (
   return g_steal_pointer (&cmd_buf);
 }
 
+static gboolean
+elanmoc_is_proto_v2 (FpDevice *dev)
+{
+  return fpi_device_get_driver_data (dev) == ELANMOC_PROTO_V2;
+}
+
+/* Compose the command that reads back which user_id occupies a storage slot.
+ * ELANMOC_PROTO_V2 chips never answer get-userid and use finger-info instead;
+ * in both variants the slot byte directly follows the header.
+ */
+static guint8 *
+elanmoc_compose_finger_info_cmd (FpDevice                  *dev,
+                                 guint8                     slot,
+                                 const struct elanmoc_cmd **cmd_info)
+{
+  guint8 *cmd_buf = NULL;
+
+  *cmd_info = elanmoc_is_proto_v2 (dev) ?
+              &elanmoc_finger_info_cmd_v2 : &elanmoc_get_userid_cmd;
+
+  cmd_buf = elanmoc_compose_cmd (*cmd_info);
+  cmd_buf[(*cmd_info)->cmd_len - 1] = slot;
+
+  return cmd_buf;
+}
+
+/* Header byte and user_id length offset of the corresponding response. */
+static guint8
+elanmoc_finger_info_hdr (FpDevice *dev)
+{
+  return elanmoc_is_proto_v2 (dev) ? 0x40 : 0x43;
+}
+
+static int
+elanmoc_userid_len_offset (FpDevice *dev)
+{
+  return elanmoc_is_proto_v2 (dev) ?
+         ELANMOC_USERID_LEN_OFFSET_V2 : ELANMOC_USERID_LEN_OFFSET;
+}
